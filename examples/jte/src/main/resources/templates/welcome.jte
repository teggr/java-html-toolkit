@param String name
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>JTE preview example</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 42rem; margin: 4rem auto; padding: 1rem; }
        main { border: 1px solid #ddd; border-radius: 1rem; padding: 2rem; }
    </style>
</head>
<body>
<main>
    <h1>Hello, ${name}!</h1>
    <p>This page is rendered from the same JTE template and model as its Java HTML Toolkit preview.</p>
</main>
</body>
</html>
